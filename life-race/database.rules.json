{
  "rules": {
    "lifeRaceRooms": {
      "$room": {
        ".read": "auth != null",
        ".write": "auth != null && ((!data.exists() && newData.child('host').val() === auth.uid) || data.child('host').val() === auth.uid)",
        "players": {
          "$player": {
            ".write": "auth != null && ($player === auth.uid || root.child('lifeRaceRooms').child($room).child('host').val() === auth.uid)",
            ".validate": "newData.hasChildren(['uid','name','role','cash','actions']) && newData.child('uid').val() === $player"
          }
        }
      }
    }
  }
}